# Supabaseの「Connect」から取得するPostgreSQL接続文字列
DATABASE_URL=

# VAPIDの秘密情報。VITE_ の接頭辞を付けないこと。
VAPID_SUBJECT=mailto:your-email@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Vite開発サーバーのURL。CORSの許可元に使います。
APP_ORIGIN=http://localhost:5174

# APIサーバーの待受ポート
PORT=8787

# ODPT開発者サイトで発行するconsumer key。Gitやチャットへは保存しません。
ODPT_CONSUMER_KEY=

# 京都バスの静的GTFS-JP配信URL
KYOTO_BUS_GTFS_URL=https://api.odpt.org/api/v4/files/odpt/KyotoBus/AllLinesAnotherversion.zip?date=current
